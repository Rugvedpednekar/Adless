# Local development defaults. Never place real credentials in this file.
ENVIRONMENT=development
LOG_LEVEL=info

# Browser API origin. Leave empty in the Railway Docker build for same-origin /api requests.
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Cloud / Vertex AI / private GCS
GOOGLE_CLOUD_PROJECT=adless-ai-2026
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=adless-media-2026
GEMINI_MODEL=gemini-2.5-flash
# Base64 of a service-account JSON document; Railway secret only. Local ADC is used when absent.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional runtime catalog location. Railway container storage is ephemeral unless a volume is attached.
VIDEO_CATALOG_PATH=/var/lib/adless/video_catalog.json
INCLUDE_BOOTSTRAP_CATALOG=true

# ClickHouse HTTP analytics event storage. Values are Railway secrets except the host.
CLICKHOUSE_HOST=https://your-service.region.provider.clickhouse.cloud:8443
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Railway injects PORT automatically. Use 8080 for local Docker runs.
PORT=8080

# Campaign selection remains dependent on official ClickHouse Remote MCP OAuth.
# CODEX_CLI_PATH is only useful in local development with an authenticated Codex CLI.
CODEX_CLI_PATH=
