# Adless Environment Variables Blueprint

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL Configuration (Phase 5+)
# DATABASE_URL=postgresql://user:password@localhost:5432/adless

# ClickHouse Configuration (Phase 6+)
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=adless
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=

# Google Cloud & Gemini Configuration (Phase 7+)
GOOGLE_CLOUD_PROJECT=adless-ai-2026
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GCS_BUCKET=
GEMINI_MODEL=gemini-2.5-flash

# Authentication (Phase 3+)
# JWT_SECRET=change-this-in-production-secret-key-32-chars
